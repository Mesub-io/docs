{
  "$schema": "https://holocron.so/docs.json",
  "name": "Mesub - Docs",
  "logo": { "light": "/logo.svg", "dark": "/logo-dark.svg", "href": "https://mesub.io" },
  "description": "Documentation for Mesub, recurring payments on Solana.",
  "favicon": "/icon.png",
  "colors": {
    // The same orange in both themes: left alone, dark mode washes it to pink.
    "primary": "#f46036",
    "light": "#f46036",
    "dark": "#f46036"
  },
  "icons": {
    "library": "lucide"
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting started",
        "icon": "lucide:rocket",
        "pages": ["index", "docs/how-it-works", "docs/quickstart", "docs/access", "docs/lifecycle", "docs/webhooks"]
      },
      {
        "group": "AI",
        "icon": "lucide:bot",
        "pages": ["docs/mcp", "docs/skills"]
      }
    ]
  }
}
